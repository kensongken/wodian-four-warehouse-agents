{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:photo-organizer:album-product-categorization:1.0",
  "title": "Album Product Categorization Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "generated_at",
    "data_classification",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "album-product-categorization/1.0"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_classification": {
      "enum": [
        "synthetic_no_customer_data",
        "opc_owned_product_material_no_customer_data"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3000,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "occurred_at",
        "opc_id",
        "album_product_id",
        "snapshot_version",
        "source_import_task_id",
        "source_type",
        "images",
        "human_confirmation",
        "categorization_input",
        "consent",
        "allowed_consumers",
        "mall_product_id",
        "bead_id"
      ],
      "properties": {
        "schema_version": {
          "const": "album-product-categorization/1.0"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "const": "album.product.snapshot.confirmed.v1"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "opc_id": {
          "$ref": "#/$defs/stable_id"
        },
        "album_product_id": {
          "$ref": "#/$defs/stable_id"
        },
        "snapshot_version": {
          "type": "integer",
          "minimum": 1
        },
        "source_import_task_id": {
          "$ref": "#/$defs/stable_id"
        },
        "source_type": {
          "enum": [
            "first_sale_bead",
            "legacy_material",
            "redesign_output"
          ]
        },
        "images": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {
                "const": "original"
              }
            }
          },
          "minContains": 1,
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "human_confirmation": {
          "$ref": "#/$defs/human_confirmation"
        },
        "categorization_input": {
          "$ref": "#/$defs/categorization_input"
        },
        "consent": {
          "$ref": "#/$defs/consent"
        },
        "allowed_consumers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "contains": {
            "const": "categorization"
          },
          "items": {
            "enum": [
              "categorization",
              "mall_draft_export"
            ]
          }
        },
        "mall_product_id": {
          "type": "null"
        },
        "bead_id": {
          "type": "null"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "role",
        "sha256",
        "byte_size",
        "media_type",
        "captured_at",
        "imported_at",
        "storage_ref",
        "source_asset_id",
        "transform"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "enum": [
            "original",
            "crop"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/heic",
            "image/heif"
          ]
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "imported_at": {
          "type": "string",
          "format": "date-time"
        },
        "storage_ref": {
          "type": "string",
          "minLength": 12,
          "maxLength": 512,
          "pattern": "^evidence/(?!.*\\.\\.)(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "source_asset_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "transform": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/transform"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "crop"
              }
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "source_asset_id": {
                "type": "string",
                "format": "uuid"
              },
              "transform": {
                "$ref": "#/$defs/transform"
              }
            }
          },
          "else": {
            "properties": {
              "source_asset_id": {
                "type": "null"
              },
              "transform": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "crop_box",
        "tool_version"
      ],
      "properties": {
        "kind": {
          "const": "crop"
        },
        "crop_box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "tool_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
        }
      }
    },
    "human_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confirmed_by",
        "confirmed_at",
        "confirmation_scope"
      ],
      "properties": {
        "status": {
          "const": "confirmed"
        },
        "confirmed_by": {
          "$ref": "#/$defs/stable_id"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "confirmation_scope": {
          "const": "grouping_membership"
        }
      }
    },
    "categorization_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level_1_candidate",
        "level_2_candidate",
        "candidate_source",
        "confidence",
        "assertion_scope"
      ],
      "properties": {
        "level_1_candidate": {
          "enum": [
            "南红",
            "沉香",
            "翡翠",
            "和田玉",
            "蜜蜡",
            "珍珠",
            "水晶",
            "彩宝",
            "贵金属",
            "其他",
            "无法判断"
          ]
        },
        "level_2_candidate": {
          "enum": [
            "手串",
            "项链",
            "吊坠",
            "挂件",
            "戒指",
            "耳饰",
            "手镯",
            "珠子/散珠",
            "摆件",
            "配件",
            "其他",
            "无法判断"
          ]
        },
        "candidate_source": {
          "enum": [
            "operator_seed",
            "ai_candidate"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "assertion_scope": {
          "const": "candidate_only"
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis"
      ],
      "properties": {
        "status": {
          "const": "not_required"
        },
        "basis": {
          "const": "opc_owned_product_material"
        }
      }
    }
  }
}
