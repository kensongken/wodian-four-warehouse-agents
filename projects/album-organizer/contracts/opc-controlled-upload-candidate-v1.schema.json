{
  "$comment": "Technical handoff candidate only; task binding and upload have not started.",
  "$defs": {
    "ControlledUploadCandidateItem": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "maximum": 104857600,
          "title": "Byte Size",
          "type": "integer"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "filename": {
          "pattern": "^[0-9a-f-]{36}\\.(jpg|png|heic)$",
          "title": "Filename",
          "type": "string"
        },
        "human_privacy_reviewed": {
          "const": true,
          "title": "Human Privacy Reviewed",
          "type": "boolean"
        },
        "local_asset_id": {
          "format": "uuid",
          "title": "Local Asset Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/heic"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "position": {
          "maximum": 4,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "privacy_metadata_status": {
          "const": "no_sensitive_metadata_detected",
          "title": "Privacy Metadata Status",
          "type": "string"
        },
        "retry": {
          "const": false,
          "title": "Retry",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "primary",
            "detail"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "local_asset_id",
        "role",
        "position",
        "filename",
        "media_type",
        "byte_size",
        "sha256",
        "captured_at",
        "human_privacy_reviewed",
        "privacy_metadata_status",
        "retry"
      ],
      "title": "ControlledUploadCandidateItem",
      "type": "object"
    }
  },
  "$id": "urn:photo-organizer:opc-controlled-upload-candidate:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "album_product_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "Album Product Id",
      "type": "string"
    },
    "authorization_basis": {
      "const": "opc_self_owned_product_material",
      "title": "Authorization Basis",
      "type": "string"
    },
    "authorized_at": {
      "format": "date-time",
      "title": "Authorized At",
      "type": "string"
    },
    "authorized_by": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "Authorized By",
      "type": "string"
    },
    "auto_publish": {
      "const": false,
      "title": "Auto Publish",
      "type": "boolean"
    },
    "bead_id": {
      "title": "Bead Id",
      "type": "null"
    },
    "candidate_id": {
      "pattern": "^opc-controlled-upload-candidate:[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "claims_not_evaluated": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "authenticity",
          "type": "string"
        },
        {
          "const": "origin",
          "type": "string"
        },
        {
          "const": "quality",
          "type": "string"
        },
        {
          "const": "warehouse_acceptance",
          "type": "string"
        }
      ],
      "title": "Claims Not Evaluated",
      "type": "array"
    },
    "customer_data_present": {
      "const": false,
      "title": "Customer Data Present",
      "type": "boolean"
    },
    "data_classification": {
      "const": "opc_owned_product_material_no_customer_data",
      "title": "Data Classification",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ControlledUploadCandidateItem"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Items",
      "type": "array"
    },
    "mall_product_id": {
      "title": "Mall Product Id",
      "type": "null"
    },
    "material_owner": {
      "const": "opc",
      "title": "Material Owner",
      "type": "string"
    },
    "next_action": {
      "const": "bind_to_verified_opc_upload_task",
      "title": "Next Action",
      "type": "string"
    },
    "opc_authority_state": {
      "const": "requires_authenticated_revalidation",
      "title": "Opc Authority State",
      "type": "string"
    },
    "opc_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "Opc Id",
      "type": "string"
    },
    "privacy_review_confirmed": {
      "const": true,
      "title": "Privacy Review Confirmed",
      "type": "boolean"
    },
    "publication_state": {
      "const": "not_created",
      "title": "Publication State",
      "type": "string"
    },
    "schema_version": {
      "const": "opc-controlled-upload-candidate/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shared_market_opt_in": {
      "const": false,
      "title": "Shared Market Opt In",
      "type": "boolean"
    },
    "source_readiness_id": {
      "pattern": "^opc-real-sku-pilot-readiness:[0-9a-f]{64}$",
      "title": "Source Readiness Id",
      "type": "string"
    },
    "source_type": {
      "const": "first_sale_bead",
      "title": "Source Type",
      "type": "string"
    },
    "status": {
      "const": "ready_for_authenticated_task_binding",
      "title": "Status",
      "type": "string"
    },
    "target_chain": {
      "const": "sellable_product_material",
      "title": "Target Chain",
      "type": "string"
    },
    "target_task_id": {
      "title": "Target Task Id",
      "type": "null"
    },
    "task_binding_state": {
      "const": "not_bound",
      "title": "Task Binding State",
      "type": "string"
    },
    "upload_state": {
      "const": "not_started",
      "title": "Upload State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "status",
    "source_readiness_id",
    "opc_id",
    "opc_authority_state",
    "album_product_id",
    "source_type",
    "target_chain",
    "data_classification",
    "material_owner",
    "authorization_basis",
    "authorized_by",
    "authorized_at",
    "privacy_review_confirmed",
    "customer_data_present",
    "items",
    "claims_not_evaluated",
    "target_task_id",
    "task_binding_state",
    "upload_state",
    "next_action",
    "mall_product_id",
    "bead_id",
    "publication_state",
    "auto_publish",
    "shared_market_opt_in"
  ],
  "title": "ControlledUploadCandidate",
  "type": "object",
  "x-semantic-validation": {
    "command": "python scripts/prepare_opc_real_sku_pilot.py --readiness <readiness.json> --image <local_image_id=local_path>... --output <candidate.json> --check",
    "required": true,
    "stable_error": "candidate_stale"
  }
}
