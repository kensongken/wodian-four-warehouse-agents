{
  "$defs": {
    "AcceptedImageEvidence": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "maximum": 104857600,
          "title": "Byte Size",
          "type": "integer"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Captured At"
        },
        "evidence_asset_id": {
          "format": "uuid",
          "title": "Evidence Asset Id",
          "type": "string"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/heic",
            "image/heif"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "const": "original",
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "storage_ref": {
          "maxLength": 54,
          "minLength": 54,
          "pattern": "^evidence/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/original$",
          "title": "Storage Ref",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "evidence_asset_id",
        "role",
        "sha256",
        "byte_size",
        "media_type",
        "captured_at",
        "imported_at",
        "storage_ref"
      ],
      "title": "AcceptedImageEvidence",
      "type": "object"
    },
    "Level1Category": {
      "enum": [
        "南红",
        "沉香",
        "翡翠",
        "和田玉",
        "蜜蜡",
        "珍珠",
        "水晶",
        "彩宝",
        "贵金属",
        "其他",
        "无法判断"
      ],
      "title": "Level1Category",
      "type": "string"
    },
    "Level2Category": {
      "enum": [
        "手串",
        "项链",
        "吊坠",
        "挂件",
        "戒指",
        "耳饰",
        "手镯",
        "珠子/散珠",
        "摆件",
        "配件",
        "其他",
        "无法判断"
      ],
      "title": "Level2Category",
      "type": "string"
    },
    "ProductSourceType": {
      "enum": [
        "first_sale_bead",
        "legacy_material",
        "redesign_output"
      ],
      "title": "ProductSourceType",
      "type": "string"
    }
  },
  "$id": "urn:photo-organizer:opc-sku-material-acceptance:2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "Acceptance Id",
      "type": "string"
    },
    "acceptance_status": {
      "const": "material_ready_for_mall_draft_not_listed",
      "title": "Acceptance Status",
      "type": "string"
    },
    "album_product_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "Album Product Id",
      "type": "string"
    },
    "auto_publish": {
      "const": false,
      "title": "Auto Publish",
      "type": "boolean"
    },
    "bead_id": {
      "title": "Bead Id",
      "type": "null"
    },
    "claims_not_evaluated": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "authenticity",
          "type": "string"
        },
        {
          "const": "origin",
          "type": "string"
        },
        {
          "const": "quality",
          "type": "string"
        },
        {
          "const": "warehouse_acceptance",
          "type": "string"
        }
      ],
      "title": "Claims Not Evaluated",
      "type": "array"
    },
    "classification_id": {
      "format": "uuid",
      "title": "Classification Id",
      "type": "string"
    },
    "classification_version": {
      "minimum": 1,
      "title": "Classification Version",
      "type": "integer"
    },
    "confirmed_at": {
      "format": "date-time",
      "title": "Confirmed At",
      "type": "string"
    },
    "confirmed_by": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "Confirmed By",
      "type": "string"
    },
    "confirmed_level_1": {
      "$ref": "#/$defs/Level1Category"
    },
    "confirmed_level_2": {
      "$ref": "#/$defs/Level2Category"
    },
    "data_classification": {
      "enum": [
        "synthetic_no_customer_data",
        "opc_owned_product_material_no_customer_data"
      ],
      "title": "Data Classification",
      "type": "string"
    },
    "download_confirmation_event_id": {
      "format": "uuid",
      "title": "Download Confirmation Event Id",
      "type": "string"
    },
    "download_ttl_seconds": {
      "const": 300,
      "title": "Download Ttl Seconds",
      "type": "integer"
    },
    "download_verified_asset_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Download Verified Asset Ids",
      "type": "array"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/AcceptedImageEvidence"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Images",
      "type": "array"
    },
    "mall_product_id": {
      "title": "Mall Product Id",
      "type": "null"
    },
    "opc_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
      "title": "Opc Id",
      "type": "string"
    },
    "publication_mode": {
      "const": "draft_only",
      "title": "Publication Mode",
      "type": "string"
    },
    "review_id": {
      "format": "uuid",
      "title": "Review Id",
      "type": "string"
    },
    "schema_version": {
      "const": "opc-sku-material-acceptance/2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_version": {
      "minimum": 1,
      "title": "Snapshot Version",
      "type": "integer"
    },
    "source_event_id": {
      "format": "uuid",
      "title": "Source Event Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/ProductSourceType"
    },
    "validated_at": {
      "format": "date-time",
      "title": "Validated At",
      "type": "string"
    }
  },
  "required": [
    "acceptance_id",
    "validated_at",
    "data_classification",
    "acceptance_status",
    "opc_id",
    "album_product_id",
    "snapshot_version",
    "source_type",
    "source_event_id",
    "classification_id",
    "review_id",
    "classification_version",
    "confirmed_level_1",
    "confirmed_level_2",
    "confirmed_by",
    "confirmed_at",
    "images",
    "download_verified_asset_ids",
    "download_ttl_seconds",
    "claims_not_evaluated",
    "mall_product_id",
    "bead_id",
    "publication_mode",
    "auto_publish",
    "schema_version",
    "download_confirmation_event_id"
  ],
  "title": "SkuMaterialAcceptanceReceipt",
  "type": "object"
}
