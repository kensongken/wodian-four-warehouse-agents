{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opc.example/v0.1/approved-product-passport.schema.json",
  "title": "商城可调用的已确认 ProductPassport",
  "description": "仅包含人工确认、当前可售且无私有证据的商品护照。AI 候选与撤回历史保存在独立审计事件中。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_passport_id",
    "sku_id",
    "approved_attributes",
    "evidence_refs",
    "taxonomy_version",
    "availability_status",
    "reviewer",
    "version"
  ],
  "properties": {
    "product_passport_id": {"type": "string", "format": "uuid"},
    "sku_id": {"type": "string", "minLength": 1},
    "approved_attributes": {"type": "object", "minProperties": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_type", "status", "visibility", "ref"],
        "properties": {
          "evidence_id": {"type": "string", "format": "uuid"},
          "evidence_type": {"type": "string", "minLength": 1},
          "status": {"const": "approved"},
          "visibility": {"const": "public"},
          "ref": {"type": "string", "format": "uri"}
        }
      }
    },
    "taxonomy_version": {"const": "product-taxonomy-v0.1"},
    "availability_status": {"const": "available"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_type", "reviewer_id", "reviewed_at"],
      "properties": {
        "reviewer_type": {"const": "human"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "version": {"type": "integer", "minimum": 1}
  }
}
