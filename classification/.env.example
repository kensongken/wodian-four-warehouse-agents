APP_ENV=development
DATABASE_URL=postgresql+asyncpg://product_engine:product_engine_dev@localhost:5432/product_engine
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=product-engine-dev
S3_ACCESS_KEY_ID=product_engine_dev
S3_SECRET_ACCESS_KEY=local-development-only
ALBUM_SIGNING_SECRET=replace-with-at-least-32-random-characters
SALES_SIGNING_SECRET=replace-with-at-least-32-random-characters
STYLE_SIGNING_SECRET=replace-with-at-least-32-random-characters
ADMIN_SIGNING_SECRET=replace-with-at-least-32-random-characters
SALES_WEBHOOK_URL=http://localhost:9100/api/integrations/product-image-engine/events
SIGNATURE_TOLERANCE_SECONDS=300
