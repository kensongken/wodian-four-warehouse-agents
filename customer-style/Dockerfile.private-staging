FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml uv.lock alembic.ini ./
COPY alembic ./alembic
COPY src ./src
COPY scripts ./scripts

RUN pip install --no-cache-dir uv==0.12.3 \
    && uv sync --frozen --no-dev --no-editable \
    && useradd --create-home --uid 10001 style-runtime \
    && mkdir -p /data \
    && chown -R style-runtime:style-runtime /app /data

USER style-runtime
ENV PATH="/app/.venv/bin:$PATH"
VOLUME ["/data"]
EXPOSE 8000

ENTRYPOINT ["python", "-m", "scripts.private_staging_entrypoint"]
