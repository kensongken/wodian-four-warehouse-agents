APP_ENV=production
SOURCE_SHA=REPLACE_WITH_FULL_40_HEX_RELEASE_SHA
DATABASE_URL=REPLACE_FROM_PLATFORM_SECRET
DATABASE_MIGRATION_URL=REPLACE_ONLY_IN_MIGRATION_JOB
DATABASE_GRANT_URL=REPLACE_ONLY_IN_GRANT_JOB
STYLE_API_DB_ROLE=style_api
STYLE_EXECUTOR_DB_ROLE=style_executor
STYLE_WAREHOUSE_V3_ENABLED=true
STYLE_WAREHOUSE_SIGNING_SECRET=REPLACE_FROM_PLATFORM_SECRET
STYLE_ASSET_BACKEND=s3
STYLE_S3_ENDPOINT=https://REPLACE_PRIVATE_STORAGE_ENDPOINT
STYLE_S3_REGION=REPLACE_REGION
STYLE_S3_BUCKET=REPLACE_PRIVATE_BUCKET
STYLE_S3_PREFIX=style-v1
STYLE_S3_ACCESS_KEY=REPLACE_FROM_PLATFORM_SECRET
STYLE_S3_SECRET_KEY=REPLACE_FROM_PLATFORM_SECRET
STYLE_STORAGE_CAPABILITY_SECRET=REPLACE_FROM_PLATFORM_SECRET_MINIMUM_32_BYTES
STYLE_EXECUTOR_ENABLED=false
STYLE_EXECUTOR_PROVIDER=disabled
STYLE_EXECUTOR_MODEL=disabled
STYLE_EXECUTOR_MAXIMUM_COST_USD=0
STYLE_EXECUTOR_ESTIMATED_COST_USD=0
REAL_IMAGE_ENABLED=false
